{
  "name": "gpt-in-a-tab",
  "version": "0.1.0",
  "private": true,
  "description": "Train a small transformer in your browser on hand-written WebGPU kernels, watch an induction head form, then take the model apart: knockouts, activation patching and a sparse autoencoder.",
  "license": "MIT",
  "author": "Harry Freeman",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:gpu": "node scripts/gpu-parity.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:browsers": "node scripts/browsers.mjs",
    "perf": "node scripts/perf.mjs",
    "measure": "node scripts/measure.mjs",
    "shots": "node scripts/shoot.mjs",
    "icons": "node scripts/icons.mjs",
    "fetch:texts": "node scripts/fetch-texts.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "licences": "node scripts/check-licences.mjs",
    "record": "node scripts/record.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.19.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
